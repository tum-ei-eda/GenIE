n7_3 [group="lane3", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Report &amp; finalize</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Permissions · summary · bundle · cleanup</FONT></TD></TR></TABLE>>];
n6_3 -> n7_3;
{rank=same; p7; n7_0; n7_1; n7_2; n7_3;}
p7 -> n7_0 -> n7_1 -> n7_2 -> n7_3 [style=invis, weight=100];
legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Reading the figure</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Gray: shared phase · green: added evaluation · blue: replacement · amber: expanded hardware refinement<BR/>Colors describe structure, not validation. Physical HLS / timing-enabled PerfSim / synthesis validation is pending.<BR/>Each column is a sequential flow; refinement expands the evaluation block at explicit candidate stages.</FONT></TD></TR></TABLE>>];
n7_1 -> legend [style=invis]; n7_2 -> legend [style=invis];
