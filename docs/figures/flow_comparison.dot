n6_0 [group="lane0", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Filter → regenerate</B></TD></TR><TR><TD><FONT POINT-SIZE="10">initial → filtered<BR/>Generate instructions &amp; ETISS core</FONT></TD></TR></TABLE>>];
n5_0 -> n6_0;
n6_1 [group="lane1", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Filter → regenerate</B></TD></TR><TR><TD><FONT POINT-SIZE="10">initial → filtered<BR/>Generate instructions &amp; ETISS core</FONT></TD></TR></TABLE>>];
n5_1 -> n6_1;
n6_2 [group="lane2", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Filter → regenerate</B></TD></TR><TR><TD><FONT POINT-SIZE="10">initial → filtered<BR/>Generate instructions &amp; ETISS core</FONT></TD></TR></TABLE>>];
n5_2 -> n6_2;
n6_3 [group="lane3", width=3.15, fillcolor="#FFF0D5", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Filter → select → reevaluate</B></TD></TR><TR><TD><FONT POINT-SIZE="10">filtered: ISS evaluation + HLS + scores<BR/>filtered_selected → final<BR/>final: ISS evaluation + HLS + synthesis</FONT></TD></TR></TABLE>>];
n5_3 -> n6_3;
{rank=same; p6; n6_0; n6_1; n6_2; n6_3;}
