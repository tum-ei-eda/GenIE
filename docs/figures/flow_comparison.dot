n2_0 [group="lane0", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Discover candidates</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Load → analyze → pick → CDFG → query</FONT></TD></TR></TABLE>>];
n1_0 -> n2_0;
n2_1 [group="lane1", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Discover candidates</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Load → analyze → pick → CDFG → query</FONT></TD></TR></TABLE>>];
n1_1 -> n2_1;
n2_2 [group="lane2", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Discover candidates</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Load → analyze → pick → CDFG → query</FONT></TD></TR></TABLE>>];
n1_2 -> n2_2;
n2_3 [group="lane3", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Discover candidates</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Load → analyze → pick → CDFG → query</FONT></TD></TR></TABLE>>];
