n4_0 -> n5_0;
n5_1 [group="lane1", width=3.15, fillcolor="#DDF1E9", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Evaluate &amp; reanalyze</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Benchmarks + trace / reanalysis<BR/>Utilization → score → sort</FONT></TD></TR></TABLE>>];
n4_1 -> n5_1;
n5_2 [group="lane2", width=3.15, fillcolor="#DCEBFA", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>PerfSim benchmark &amp; compare</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Microarchitecture sweep + CPI ranking<BR/>Per-instruction evaluation retained</FONT></TD></TR></TABLE>>];
n4_2 -> n5_2;
n5_3 [group="lane3", width=3.15, fillcolor="#DDF1E9", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Evaluate &amp; reanalyze</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Benchmarks + trace / reanalysis<BR/>Utilization → score → sort</FONT></TD></TR></TABLE>>];
