digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.22", ranksep="0.32", splines=polyline, fontname="Arial", labelloc=t, labeljust=l, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>GenIE | Flow comparison</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Shared phases aligned across four registered Python flows · grouped steps, current implementation</FONT></TD></TR></TABLE>>];
node [shape=box, style="rounded,filled", color="#CBD5E1", fillcolor="#F1F4F8", fontname="Arial", fontsize=12, margin="0.07,0.04", penwidth=1.1];
edge [color="#64748B", arrowsize=0.65, penwidth=1.2, fontname="Arial", fontsize=10];
corner [shape=plain, label="PHASE", fontcolor="#64748B"];
h0 [fillcolor="#172B4D", fontcolor="white", color="#172B4D", width=3.15, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>ISS · default</B></TD></TR><TR><TD><FONT POINT-SIZE="10">DefaultGenIEFlow</FONT></TD></TR></TABLE>>];
h1 [fillcolor="#172B4D", fontcolor="white", color="#172B4D", width=3.15, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>ISS · extended evaluation</B></TD></TR><TR><TD><FONT POINT-SIZE="10">ISSEvaluationFlow</FONT></TD></TR></TABLE>>];
h2 [fillcolor="#172B4D", fontcolor="white", color="#172B4D", width=3.15, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Performance simulation</B></TD></TR><TR><TD><FONT POINT-SIZE="10">PerfSimGenIEFlow</FONT></TD></TR></TABLE>>];
h3 [fillcolor="#172B4D", fontcolor="white", color="#172B4D", width=3.15, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Hardware-aware selection</B></TD></TR><TR><TD><FONT POINT-SIZE="10">HardwareSelectionFlow</FONT></TD></TR></TABLE>>];
{rank=same; corner; h0; h1; h2; h3;}
corner -> h0 -> h1 -> h2 -> h3 [style=invis, weight=100];
p0 [shape=plain, fontcolor="#64748B", label="Setup"];
n0_0 [group="lane0", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Setup &amp; checks</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Tools · session environment</FONT></TD></TR></TABLE>>];
h0 -> n0_0;
n0_1 [group="lane1", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Setup &amp; checks</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Tools · session environment</FONT></TD></TR></TABLE>>];
h1 -> n0_1;
n0_2 [group="lane2", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Setup &amp; checks</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Tools · session environment</FONT></TD></TR></TABLE>>];
h2 -> n0_2;
n0_3 [group="lane3", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Setup &amp; checks</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Tools · session environment</FONT></TD></TR></TABLE>>];
h3 -> n0_3;
{rank=same; p0; n0_0; n0_1; n0_2; n0_3;}
p0 -> n0_0 -> n0_1 -> n0_2 -> n0_3 [style=invis, weight=100];
p1 [shape=plain, fontcolor="#64748B", label="Baseline"];
p0 -> p1 [style=invis, weight=100];
n1_0 [group="lane0", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Benchmark &amp; instruction trace</B></TD></TR><TR><TD><FONT POINT-SIZE="10">MLonMCU.Bench / Trace</FONT></TD></TR></TABLE>>];
n0_0 -> n1_0;
n1_1 [group="lane1", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Benchmark &amp; instruction trace</B></TD></TR><TR><TD><FONT POINT-SIZE="10">MLonMCU.Bench / Trace</FONT></TD></TR></TABLE>>];
n0_1 -> n1_1;
n1_2 [group="lane2", width=3.15, fillcolor="#DCEBFA", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>PerfSim benchmark &amp; trace</B></TD></TR><TR><TD><FONT POINT-SIZE="10">PerfSimBench / PerfSimTrace</FONT></TD></TR></TABLE>>];
n0_2 -> n1_2;
n1_3 [group="lane3", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Benchmark &amp; instruction trace</B></TD></TR><TR><TD><FONT POINT-SIZE="10">MLonMCU.Bench / Trace</FONT></TD></TR></TABLE>>];
n0_3 -> n1_3;
{rank=same; p1; n1_0; n1_1; n1_2; n1_3;}
p1 -> n1_0 -> n1_1 -> n1_2 -> n1_3 [style=invis, weight=100];
