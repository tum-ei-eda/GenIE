n3_1 -> n4_1;
n4_2 [group="lane2", width=3.15, fillcolor="#DCEBFA", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>LLVM + timing simulator</B></TD></TR><TR><TD><FONT POINT-SIZE="10">HLS scheduling → PerfSim retargeting<BR/>RetargetPerfSim replaces RetargetISS</FONT></TD></TR></TABLE>>];
n3_2 -> n4_2;
n4_3 [group="lane3", width=3.15, fillcolor="#DDF1E9", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>LLVM + functional ISS</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Combined / split LLVM · ETISS<BR/>Compiler-support annotation</FONT></TD></TR></TABLE>>];
