n3_0 [group="lane0", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Generate instructions &amp; core</B></TD></TR><TR><TD><FONT POINT-SIZE="10">GenerateInstrs / GenerateETISSCore</FONT></TD></TR></TABLE>>];
n2_0 -> n3_0;
n3_1 [group="lane1", width=3.15, fillcolor="#DDF1E9", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Generate + encoding metrics</B></TD></TR><TR><TD><FONT POINT-SIZE="10">GenerateInstrs / GenerateETISSCore<BR/>AssignEncodingScore</FONT></TD></TR></TABLE>>];
n2_1 -> n3_1;
n3_2 [group="lane2", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Generate instructions &amp; core</B></TD></TR><TR><TD><FONT POINT-SIZE="10">GenerateInstrs / GenerateETISSCore</FONT></TD></TR></TABLE>>];
n2_2 -> n3_2;
n3_3 [group="lane3", width=3.15, fillcolor="#DDF1E9", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>Generate + encoding metrics</B></TD></TR><TR><TD><FONT POINT-SIZE="10">GenerateInstrs / GenerateETISSCore<BR/>AssignEncodingScore</FONT></TD></TR></TABLE>>];
n2_3 -> n3_3;
{rank=same; p3; n3_0; n3_1; n3_2; n3_3;}
p3 -> n3_0 -> n3_1 -> n3_2 -> n3_3 [style=invis, weight=100];
p4 [shape=plain, fontcolor="#64748B", label="Retargeting"];
p3 -> p4 [style=invis, weight=100];
n4_0 [group="lane0", width=3.15, fillcolor="#F1F4F8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>LLVM + functional ISS</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Combined / split LLVM · ETISS</FONT></TD></TR></TABLE>>];
n3_0 -> n4_0;
